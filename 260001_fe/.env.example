# Frontend Environment Configuration

# Development configuration (local)
# Copy this to .env.local for local development

# API URL - Points to backend server
# For local development: http://localhost:5000/api
# For deployed backend: https://your-backend.example.com/api
VITE_API_URL=http://localhost:5000/api

# Use mock data for demo/offline mode
# Set to 'true' for portfolio deployment without backend
# Set to 'false' to use real API endpoints
VITE_USE_MOCK_DATA=true
