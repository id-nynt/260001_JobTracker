# Frontend environment configuration
# Copy to .env.local for local development.

# Backend API. Leave unset in development: Vite proxies /api to http://localhost:5000
# (see vite.config.js). Set it when the frontend and backend run on different hosts,
# e.g. VITE_API_URL=https://your-backend.example.com/api
# VITE_API_URL=

# There is no "mock mode" switch any more: the "Try the demo" button on the login page
# runs the app on sample data stored in the browser, with no backend.
